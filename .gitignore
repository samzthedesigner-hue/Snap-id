# ==========================================
# 1. NODE / CAPACITOR / ANDROID
# ==========================================
node_modules/
npm-debug.log*
package-lock.json
yarn-error.log*

# Capacitor builds (these get generated automatically by GitHub Actions)
frontend/android/
frontend/ios/
frontend/.capacitor/

# Build outputs & APK files (we don't want these in git)
out/
*.apk
*.aab
*.ap_

# ==========================================
# 2. PYTHON / BACKEND
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 3. DATABASES & SECRETS (CRITICAL)
# ==========================================
# Local SQLite databases (we use Supabase, but just in case)
*.db
*.sqlite
*.sqlite3
snapid.db

# Environment variable files (NEVER commit these)
.env
.env.local
.env.*.local

# ==========================================
# 4. OS & EDITOR FILES
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
